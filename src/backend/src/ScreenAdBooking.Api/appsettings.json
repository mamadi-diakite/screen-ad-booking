{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/screen-ad-booking.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "VideosPath": "App_Data/videos"
  },
  "Jwt": {
    "Issuer": "screen-ad-booking",
    "Audience": "screen-ad-booking",
    "AccessTokenMinutes": 60
  }
}
